<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cisco Network Health Report — {{ generated_at }}</title>
  <style>
    /* ── Design tokens ─────────────────────────────────────────── */
    :root {
      --bg:           #0d1117;
      --surface:      #161b22;
      --surface-2:    #1c2330;
      --border:       #30363d;
      --text-primary: #e6edf3;
      --text-muted:   #8b949e;
      --green:        #3fb950;
      --yellow:       #d29922;
      --red:          #f85149;
      --blue:         #58a6ff;
      --purple:       #bc8cff;
      --radius:       8px;
      --font:         'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ── Reset ─────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { font-size: 15px; }

    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text-primary);
      min-height: 100vh;
      padding: 2rem 1.5rem 4rem;
      line-height: 1.6;
    }

    /* ── Layout ─────────────────────────────────────────────────── */
    .container { max-width: 1200px; margin: 0 auto; }

    /* ── Header ─────────────────────────────────────────────────── */
    .header {
      display: flex;
      flex-direction: column;
      gap: .4rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 2rem;
    }
    .header-top { display: flex; align-items: center; gap: .75rem; }
    .cisco-badge {
      background: #1d6fa8;
      color: #fff;
      font-size: .7rem;
      font-weight: 700;
      letter-spacing: .08em;
      padding: .2rem .5rem;
      border-radius: 4px;
      text-transform: uppercase;
    }
    h1 {
      font-size: 1.7rem;
      font-weight: 700;
      letter-spacing: -.02em;
      color: var(--text-primary);
    }
    .header-meta { font-size: .82rem; color: var(--text-muted); }

    /* ── Summary bar ────────────────────────────────────────────── */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.1rem 1.2rem;
      display: flex;
      flex-direction: column;
      gap: .25rem;
    }
    .stat-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
    .stat-value { font-size: 2rem; font-weight: 700; line-height: 1; }
    .stat-value.green  { color: var(--green); }
    .stat-value.red    { color: var(--red); }
    .stat-value.yellow { color: var(--yellow); }
    .stat-value.blue   { color: var(--blue); }

    /* ── Section heading ────────────────────────────────────────── */
    .section-title {
      font-size: .8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .1em;
      color: var(--text-muted);
      margin: 2rem 0 1rem;
    }

    /* ── Device cards ───────────────────────────────────────────── */
    .devices-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.25rem;
    }
    .device-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: box-shadow .2s ease;
    }
    .device-card:hover { box-shadow: 0 0 0 1px var(--blue); }

    /* ── Device header ──────────────────────────────────────────── */
    .device-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .85rem 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--surface-2);
    }
    .device-name { font-weight: 700; font-size: 1.05rem; }
    .device-ip   { font-size: .78rem; color: var(--text-muted); margin-top: .1rem; }

    /* ── Health score badge ──────────────────────────────────────── */
    .score-badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .score-number {
      font-size: 1.6rem;
      font-weight: 800;
      line-height: 1;
    }
    .score-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }

    /* ── Status pill ────────────────────────────────────────────── */
    .status-pill {
      font-size: .68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .07em;
      padding: .2rem .55rem;
      border-radius: 20px;
    }
    .pill-healthy    { background: #1a3a24; color: var(--green); }
    .pill-good       { background: #2a3a1a; color: #7ee787; }
    .pill-degraded   { background: #3a2e0a; color: var(--yellow); }
    .pill-critical   { background: #3a1a1a; color: var(--red); }
    .pill-unreachable{ background: #2a1a2a; color: var(--purple); }

    /* ── Device body ────────────────────────────────────────────── */
    .device-body { padding: 1rem; }

    /* ── Info rows ──────────────────────────────────────────────── */
    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: .3rem 0;
      border-bottom: 1px solid rgba(48,54,61,.5);
      font-size: .83rem;
    }
    .info-row:last-child { border-bottom: none; }
    .info-key   { color: var(--text-muted); }
    .info-value { font-weight: 500; text-align: right; max-width: 60%; word-break: break-word; }

    /* ── Metric bars ─────────────────────────────────────────────── */
    .metric-bar-wrap { display: flex; align-items: center; gap: .5rem; min-width: 120px; }
    .metric-bar {
      flex: 1;
      height: 6px;
      background: var(--border);
      border-radius: 3px;
      overflow: hidden;
    }
    .metric-fill {
      height: 100%;
      border-radius: 3px;
      transition: width .4s ease;
    }
    .fill-green  { background: var(--green); }
    .fill-yellow { background: var(--yellow); }
    .fill-red    { background: var(--red); }
    .metric-pct  { font-size: .78rem; font-weight: 600; min-width: 36px; text-align: right; }

    /* ── Interface table ─────────────────────────────────────────── */
    .iface-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .78rem;
      margin-top: .5rem;
    }
    .iface-table th {
      text-align: left;
      color: var(--text-muted);
      font-weight: 500;
      padding: .25rem .4rem;
      border-bottom: 1px solid var(--border);
    }
    .iface-table td { padding: .25rem .4rem; }
    .iface-table tr:hover td { background: rgba(255,255,255,.03); }
    .dot {
      display: inline-block;
      width: 7px; height: 7px;
      border-radius: 50%;
      margin-right: 4px;
      vertical-align: middle;
    }
    .dot-up   { background: var(--green); }
    .dot-down { background: var(--red); }
    .dot-admin{ background: var(--text-muted); }

    /* ── VLAN table ──────────────────────────────────────────────── */
    .vlan-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .5rem; }
    .vlan-chip {
      font-size: .72rem;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: .15rem .45rem;
      color: var(--text-muted);
    }
    .vlan-chip strong { color: var(--blue); }

    /* ── OSPF table ──────────────────────────────────────────────── */
    .ospf-table {
      width: 100%;
      border-collapse: collapse;
      font-size: .78rem;
      margin-top: .4rem;
    }
    .ospf-table th { color: var(--text-muted); font-weight: 500; text-align: left; padding: .2rem .3rem; }
    .ospf-table td { padding: .2rem .3rem; }
    .state-full    { color: var(--green); font-weight: 600; }
    .state-other   { color: var(--yellow); font-weight: 600; }

    /* ── Alerts ──────────────────────────────────────────────────── */
    .alerts { margin-top: .75rem; display: flex; flex-direction: column; gap: .35rem; }
    .alert-item {
      font-size: .78rem;
      padding: .35rem .6rem;
      border-radius: 5px;
      display: flex;
      align-items: flex-start;
      gap: .4rem;
    }
    .alert-critical { background: rgba(248,81,73,.12); border-left: 3px solid var(--red);    color: #ffa198; }
    .alert-warning  { background: rgba(210,153,34,.12); border-left: 3px solid var(--yellow); color: #e3b341; }
    .alert-info     { background: rgba(88,166,255,.08); border-left: 3px solid var(--blue);   color: #79c0ff; }
    .alert-icon     { flex-shrink: 0; }

    /* ── Unreachable overlay ─────────────────────────────────────── */
    .unreachable-body {
      padding: 2rem 1rem;
      text-align: center;
      color: var(--text-muted);
    }
    .unreachable-icon { font-size: 2rem; }
    .unreachable-text { margin-top: .5rem; font-size: .85rem; }

    /* ── Score ring (health score at bottom) ─────────────────────── */
    .health-breakdown {
      margin-top: .75rem;
      padding-top: .75rem;
      border-top: 1px solid var(--border);
    }
    .breakdown-title { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); margin-bottom: .5rem; }
    .breakdown-bars  { display: flex; flex-direction: column; gap: .3rem; }
    .breakdown-row   { display: flex; align-items: center; gap: .5rem; font-size: .75rem; }
    .breakdown-key   { flex: 0 0 130px; color: var(--text-muted); }
    .breakdown-bar   { flex: 1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
    .breakdown-fill  { height: 100%; background: var(--blue); border-radius: 2px; }
    .breakdown-val   { flex: 0 0 30px; text-align: right; font-weight: 600; }

    /* ── Routing summary ─────────────────────────────────────────── */
    .route-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .4rem; }
    .route-chip {
      font-size: .72rem;
      padding: .15rem .45rem;
      border-radius: 4px;
    }
    .chip-ospf      { background: rgba(88,166,255,.15); color: var(--blue); }
    .chip-connected { background: rgba(63,185,80,.15);  color: var(--green); }
    .chip-static    { background: rgba(188,140,255,.15);color: var(--purple); }
    .chip-total     { background: var(--surface-2); color: var(--text-muted); border: 1px solid var(--border); }

    /* ── Collapsible sections ────────────────────────────────────── */
    details { margin-top: .75rem; }
    summary {
      cursor: pointer;
      font-size: .78rem;
      font-weight: 600;
      color: var(--blue);
      list-style: none;
      display: flex;
      align-items: center;
      gap: .35rem;
      user-select: none;
    }
    summary::before { content: "▶"; font-size: .6rem; transition: transform .2s; }
    details[open] summary::before { transform: rotate(90deg); }
    summary::-webkit-details-marker { display: none; }

    /* ── Footer ──────────────────────────────────────────────────── */
    footer {
      margin-top: 3rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
      font-size: .75rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: .5rem;
    }

    /* ── Responsive ──────────────────────────────────────────────── */
    @media (max-width: 600px) {
      .devices-grid { grid-template-columns: 1fr; }
      .summary-grid { grid-template-columns: repeat(2, 1fr); }
      h1 { font-size: 1.3rem; }
    }
  </style>
</head>
<body>
<div class="container">

  <!-- ── Header ──────────────────────────────────────────────────── -->
  <header class="header">
    <div class="header-top">
      <span class="cisco-badge">Cisco</span>
      <h1>Network Health Report</h1>
    </div>
    <div class="header-meta">
      Generated: {{ generated_at }} &nbsp;·&nbsp;
      {{ total }} device{{ 's' if total != 1 else '' }} in inventory
    </div>
  </header>

  <!-- ── Summary bar ─────────────────────────────────────────────── -->
  <div class="summary-grid">
    <div class="stat-card">
      <span class="stat-label">Devices Online</span>
      <span class="stat-value {{ 'green' if online == total else ('yellow' if online > 0 else 'red') }}">
        {{ online }}/{{ total }}
      </span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Avg Health Score</span>
      <span class="stat-value {{ 'green' if avg_score >= 90 else ('yellow' if avg_score >= 60 else 'red') }}">
        {{ avg_score }}
      </span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Offline</span>
      <span class="stat-value {{ 'red' if offline > 0 else 'green' }}">{{ offline }}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Critical Alerts</span>
      <span class="stat-value {{ 'red' if critical_alerts > 0 else 'green' }}">{{ critical_alerts }}</span>
    </div>
  </div>

  <!-- ── Device cards ─────────────────────────────────────────────── -->
  <p class="section-title">Device Status</p>
  <div class="devices-grid">

    {% for d in devices %}
    {% set health  = d.get('health', {}) %}
    {% set score   = health.get('score', 0) %}
    {% set status  = health.get('status', 'UNKNOWN') %}
    {% set alerts  = health.get('alerts', []) %}
    {% set version = d.get('version', {}) %}
    {% set cpu     = d.get('cpu', {}) %}
    {% set mem     = d.get('memory', {}) %}
    {% set ifaces  = d.get('interfaces', []) %}
    {% set istats  = d.get('interface_stats', {}) %}
    {% set vlans   = d.get('vlans', []) %}
    {% set ospf    = d.get('ospf_neighbors', []) %}
    {% set routing = d.get('routing', {}) %}

    {# Compute fill colour helper values #}
    {% set cpu_pct = cpu.get('one_min_pct', 0) %}
    {% set mem_pct = mem.get('used_pct', 0) %}

    <div class="device-card">
      <!-- Device header -->
      <div class="device-header">
        <div>
          <div class="device-name">{{ d.hostname }}</div>
          <div class="device-ip">{{ d.ip }}</div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:.4rem;">
          <span class="status-pill
            {% if status == 'HEALTHY' %}pill-healthy
            {% elif status == 'GOOD' %}pill-good
            {% elif status in ('DEGRADED',) %}pill-degraded
            {% elif status == 'CRITICAL' %}pill-critical
            {% else %}pill-unreachable{% endif %}">
            {{ status }}
          </span>
          <div class="score-badge">
            <span class="score-number"
              style="color:{% if score>=90 %}#3fb950{% elif score>=60 %}#d29922{% else %}#f85149{% endif %}">
              {{ score }}
            </span>
            <span class="score-label">/100</span>
          </div>
        </div>
      </div>

      <!-- Body -->
      {% if not d.get('reachable') %}
      <div class="unreachable-body">
        <div class="unreachable-icon">🔌</div>
        <div class="unreachable-text">Device unreachable — check connectivity and credentials</div>
      </div>
      {% else %}
      <div class="device-body">

        <!-- ── Basic info ── -->
        <div class="info-row">
          <span class="info-key">IOS Version</span>
          <span class="info-value">{{ version.get('ios_version', 'N/A') }}</span>
        </div>
        <div class="info-row">
          <span class="info-key">Platform</span>
          <span class="info-value">{{ version.get('platform', 'N/A') }}</span>
        </div>
        <div class="info-row">
          <span class="info-key">Uptime</span>
          <span class="info-value">{{ version.get('uptime', 'N/A') }}</span>
        </div>
        <div class="info-row">
          <span class="info-key">Collected</span>
          <span class="info-value" style="color:var(--text-muted);font-size:.75rem;">
            {{ d.get('collected_at', '')[:19] }}
          </span>
        </div>

        <!-- ── CPU ── -->
        <div class="info-row">
          <span class="info-key">CPU (1-min)</span>
          <div class="metric-bar-wrap">
            <div class="metric-bar">
              <div class="metric-fill
                {% if cpu_pct >= 80 %}fill-red{% elif cpu_pct >= 60 %}fill-yellow{% else %}fill-green{% endif %}"
                style="width:{{ [cpu_pct, 100]|min }}%"></div>
            </div>
            <span class="metric-pct
              {% if cpu_pct >= 80 %}fill-red{% elif cpu_pct >= 60 %}fill-yellow{% else %}fill-green{% endif %}"
              style="color:{% if cpu_pct >= 80 %}var(--red){% elif cpu_pct >= 60 %}var(--yellow){% else %}var(--green){% endif %}">
              {{ cpu_pct }}%
            </span>
          </div>
        </div>

        <!-- ── Memory ── -->
        <div class="info-row">
          <span class="info-key">Memory</span>
          <div class="metric-bar-wrap">
            <div class="metric-bar">
              <div class="metric-fill
                {% if mem_pct >= 80 %}fill-red{% elif mem_pct >= 60 %}fill-yellow{% else %}fill-green{% endif %}"
                style="width:{{ [mem_pct, 100]|min }}%"></div>
            </div>
            <span class="metric-pct"
              style="color:{% if mem_pct >= 80 %}var(--red){% elif mem_pct >= 60 %}var(--yellow){% else %}var(--green){% endif %}">
              {{ mem_pct }}%
            </span>
          </div>
        </div>

        <!-- ── Interface summary ── -->
        <div class="info-row">
          <span class="info-key">Interfaces</span>
          <span class="info-value">
            <span style="color:var(--green)">{{ istats.get('up', 0) }} UP</span>
            &nbsp;/&nbsp;
            <span style="color:{{ 'var(--red)' if istats.get('down',0) > 0 else 'var(--text-muted)' }}">
              {{ istats.get('down', 0) }} DOWN
            </span>
          </span>
        </div>

        <!-- ── Interface detail (collapsible) ── -->
        {% if ifaces %}
        <details>
          <summary>Interface Detail</summary>
          <table class="iface-table">
            <thead>
              <tr>
                <th>Interface</th>
                <th>IP Address</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {% for iface in ifaces %}
              <tr>
                <td>{{ iface.name }}</td>
                <td>{{ iface.ip }}</td>
                <td>
                  {% if iface.protocol == 'up' %}
                    <span class="dot dot-up"></span>up
                  {% elif 'administratively' in iface.status %}
                    <span class="dot dot-admin"></span>admin down
                  {% else %}
                    <span class="dot dot-down"></span>down
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </details>
        {% endif %}

        <!-- ── Routing summary ── -->
        {% if routing.get('total_routes', 0) > 0 %}
        <details>
          <summary>Routing Table</summary>
          <div class="route-chips">
            <span class="route-chip chip-total">Total: {{ routing.total_routes }}</span>
            {% if routing.connected %}
              <span class="route-chip chip-connected">Connected: {{ routing.connected }}</span>
            {% endif %}
            {% if routing.ospf_routes %}
              <span class="route-chip chip-ospf">OSPF: {{ routing.ospf_routes }}</span>
            {% endif %}
            {% if routing.static %}
              <span class="route-chip chip-static">Static: {{ routing.static }}</span>
            {% endif %}
            {% if routing.default_route %}
              <span class="route-chip chip-static">Default GW: {{ routing.default_route }}</span>
            {% endif %}
          </div>
        </details>
        {% endif %}

        <!-- ── OSPF neighbors ── -->
        <details>
          <summary>OSPF Neighbors
            {% if ospf %}
              ({{ ospf|length }})
            {% else %}
              — none
            {% endif %}
          </summary>
          {% if ospf %}
          <table class="ospf-table">
            <thead>
              <tr><th>Neighbor</th><th>State</th><th>Interface</th></tr>
            </thead>
            <tbody>
              {% for n in ospf %}
              <tr>
                <td>{{ n.neighbor_id }}</td>
                <td class="{{ 'state-full' if 'FULL' in n.state else 'state-other' }}">
                  {{ n.state }}
                </td>
                <td>{{ n.interface }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% else %}
          <p style="font-size:.78rem;color:var(--text-muted);margin-top:.4rem;">No OSPF neighbors established.</p>
          {% endif %}
        </details>

        <!-- ── VLANs ── -->
        {% if vlans %}
        <details>
          <summary>VLANs ({{ vlans|length }})</summary>
          <div class="vlan-chips">
            {% for v in vlans %}
            <span class="vlan-chip">
              <strong>{{ v.id }}</strong> {{ v.name }}
            </span>
            {% endfor %}
          </div>
        </details>
        {% endif %}

        <!-- ── Alerts ── -->
        {% if alerts %}
        <div class="alerts">
          {% for alert in alerts %}
          <div class="alert-item
            {% if alert.severity == 'critical' %}alert-critical
            {% elif alert.severity == 'warning' %}alert-warning
            {% else %}alert-info{% endif %}">
            <span class="alert-icon">
              {% if alert.severity == 'critical' %}🔴
              {% elif alert.severity == 'warning' %}⚠️
              {% else %}ℹ️{% endif %}
            </span>
            {{ alert.message }}
          </div>
          {% endfor %}
        </div>
        {% endif %}

        <!-- ── Health breakdown ── -->
        {% if health.get('breakdown') %}
        <div class="health-breakdown">
          <div class="breakdown-title">Health Score Breakdown</div>
          <div class="breakdown-bars">
            {% for key, val in health.breakdown.items() %}
            {% set max_weight = {'reachable':20,'interfaces_healthy':20,'ospf_neighbors':20,'cpu_ok':10,'memory_ok':10,'vlans_present':10,'routing_ok':10}[key] %}
            <div class="breakdown-row">
              <span class="breakdown-key">{{ key.replace('_',' ').title() }}</span>
              <div class="breakdown-bar">
                <div class="breakdown-fill"
                  style="width:{{ (val / max_weight * 100) if max_weight else 0 }}%"></div>
              </div>
              <span class="breakdown-val" style="color:{% if val == max_weight %}var(--green){% elif val > 0 %}var(--yellow){% else %}var(--red){% endif %}">
                {{ val }}/{{ max_weight }}
              </span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}

      </div>
      {% endif %}
    </div>
    {% endfor %}

  </div><!-- /devices-grid -->

  <!-- ── Footer ──────────────────────────────────────────────────── -->
  <footer>
    <span>Cisco Network Automation — Python + Netmiko + Jinja2</span>
    <span>Generated {{ generated_at }}</span>
  </footer>

</div><!-- /container -->
</body>
</html>
